# AlumniUp Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local. No real keys or secrets belong in this repo.

# Data source: "mock" (default, sample data, no credentials) or "supabase"
NEXT_PUBLIC_DATA_SOURCE=mock

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Stripe (test mode first: pk_test_... / sk_test_... / whsec_...)
# Live mode needs the fiscal sponsor's Stripe readiness confirmed.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Resend (primary email provider; SendGrid optional fallback)
RESEND_API_KEY=your_resend_api_key
SENDGRID_API_KEY=your_sendgrid_api_key
EMAIL_FROM=AlumniUp <noreply@alumniupdetroit.org>

# Site
NEXT_PUBLIC_SITE_URL=https://www.alumniupdetroit.org
NEXT_PUBLIC_APP_NAME=AlumniUp
