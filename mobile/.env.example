# AlumniUp mobile — environment variables (Expo).
# Copy to .env.local or set in your environment / EAS. EXPO_PUBLIC_* vars are
# inlined at bundle time, so changing them requires a rebuild / re-export.

# "mock" (default, no credentials) or "supabase"
EXPO_PUBLIC_DATA_SOURCE=mock

# Real Supabase project (needed only when DATA_SOURCE=supabase)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Base URL for the shared Next.js API routes (default https://alumniup.org)
EXPO_PUBLIC_API_URL=https://alumniup.org
